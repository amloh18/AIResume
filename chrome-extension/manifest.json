{
  "manifest_version": 3,
  "name": "CVCircle Job Saver",
  "version": "1.0.0",
  "description": "Save jobs from LinkedIn, Indeed, and other job sites to your CVCircle dashboard",
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "identity",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://glassdoor.com/*",
    "https://www.ziprecruiter.com/*",
    "https://ziprecruiter.com/*",
    "https://www.monster.com/*",
    "https://monster.com/*",
    "https://www.careerbuilder.com/*",
    "https://careerbuilder.com/*",
    "https://www.simplyhired.com/*",
    "https://simplyhired.com/*",
    "https://www.flexjobs.com/*",
    "https://www.dice.com/*",
    "https://dice.com/*",
    "https://www.angel.co/*",
    "https://angel.co/*",
    "https://www.wellfound.com/*",
    "https://wellfound.com/*",
    "https://jobs.lever.co/*",
    "https://lever.co/*",
    "https://jobs.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://www.smartrecruiters.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://www.workday.com/*",
    "https://workday.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://cvcircle.local:3000/*",
    "https://www.cvcircle.io/*",
    "https://cvcircle.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://www.ziprecruiter.com/*",
        "https://www.monster.com/*",
        "https://www.careerbuilder.com/*",
        "https://www.simplyhired.com/*",
        "https://www.flexjobs.com/*",
        "https://www.dice.com/*",
        "https://www.angel.co/*",
        "https://www.wellfound.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.smartrecruiters.com/*",
        "https://www.workday.com/*"
      ],
      "js": ["content.js", "content-sidebar.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
        {
          "matches": [
            "https://www.cvcircle.io/*",
            "https://cvcircle.io/*",
            "http://localhost:3000/*",
            "http://127.0.0.1:3000/*",
            "http://cvcircle.local:3000/*"
          ],
          "js": ["content-cvcircle.js", "content-sidebar.js"],
          "run_at": "document_end"
        }
  ],
  "action": {
    "default_title": "CVCircle Job Saver - Click to open sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://www.ziprecruiter.com/*",
        "https://www.monster.com/*",
        "https://www.careerbuilder.com/*",
        "https://www.simplyhired.com/*",
        "https://www.flexjobs.com/*",
        "https://www.dice.com/*",
        "https://www.angel.co/*",
        "https://www.wellfound.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.smartrecruiters.com/*",
        "https://www.workday.com/*"
      ]
    },
        {
          "resources": ["sidebar.html", "sidebar-loader.js", "sidebar/dist/*"],
          "matches": [
            "https://www.linkedin.com/*",
            "https://www.indeed.com/*",
            "https://www.glassdoor.com/*",
            "https://www.ziprecruiter.com/*",
            "https://www.monster.com/*",
            "https://www.careerbuilder.com/*",
            "https://www.simplyhired.com/*",
            "https://www.flexjobs.com/*",
            "https://www.dice.com/*",
            "https://www.angel.co/*",
            "https://www.wellfound.com/*",
            "https://jobs.lever.co/*",
            "https://jobs.greenhouse.io/*",
            "https://boards.greenhouse.io/*",
            "https://jobs.smartrecruiters.com/*",
            "https://www.workday.com/*",
            "https://www.cvcircle.io/*",
            "https://cvcircle.io/*",
            "http://localhost:3000/*",
            "http://127.0.0.1:3000/*",
            "http://cvcircle.local:3000/*"
          ]
        }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
