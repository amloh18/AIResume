# BuildAIResume - Stalwart Mail Server Environment Variables
# Copy this file to .env.stalwart and fill in the values

# ============================================================================
# STALWART CONFIGURATION
# ============================================================================

# Domain for the mail server
STALWART_DOMAIN=buildairesume.com

# Admin credentials (CHANGE THESE IN PRODUCTION)
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=your-secure-admin-password

# ============================================================================
# SMTP CONFIGURATION (Internal Docker Network)
# ============================================================================

# Internal SMTP server (used by BuildAIResume)
STALWART_SMTP_HOST=stalwart
STALWART_SMTP_PORT=587

# SMTP credentials for BuildAIResume application
STALWART_SMTP_USER=applications@buildairesume.com
STALWART_SMTP_PASSWORD=your-smtp-password

# ============================================================================
# TLS CONFIGURATION
# ============================================================================

# TLS certificate and key paths (inside container)
STALWART_TLS_CERT=/opt/stalwart/certs/cert.pem
STALWART_TLS_KEY=/opt/stalwart/certs/key.pem

# ============================================================================
# DNS CONFIGURATION (Required for deliverability)
# ============================================================================

# Mail server hostname
MAIL_HOSTNAME=mail.buildairesume.com

# VPS IP address (for DNS records)
VPS_PUBLIC_IP=your-vps-ip-address

# ============================================================================
# APPLICATION EMAIL CONFIGURATION
# ============================================================================

# Application sender identity
APPLICATION_SENDER_NAME=BuildAIResume
APPLICATION_SENDER_EMAIL=applications@buildairesume.com

# Rate limiting
MAX_EMAILS_PER_MINUTE=10
MAX_EMAILS_PER_HOUR=100
MAX_EMAILS_PER_DAY=1000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Restrict admin interface to localhost only
STALWART_ADMIN_LISTEN=127.0.0.1

# Prevent open relay
STALWART_RELAY_ALLOWED=false

# Authentication required for submission
STALWART_AUTH_REQUIRED=true
