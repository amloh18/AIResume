[Unit]
Description=BuildAIResume Whisper Transcription Worker
After=network.target

[Service]
Type=simple
User=buildairesume
Group=buildairesume
WorkingDirectory=/opt/buildairesume/scripts/whisper-worker
ExecStart=/opt/buildairesume/scripts/whisper-worker/.venv/bin/python worker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment
Environment="WHISPER_MODEL=small.en"
Environment="WHISPER_LANGUAGE=en"
Environment="WHISPER_DEVICE=auto"
Environment="WHISPER_COMPUTE_TYPE=auto"
Environment="WHISPER_MAX_AUDIO_SECONDS=900"
Environment="WHISPER_MAX_CONCURRENT_JOBS=1"
Environment="WHISPER_HOST=127.0.0.1"
Environment="WHISPER_PORT=8787"
Environment="WHISPER_DEBUG=false"

# Resource limits
MemoryMax=2G
CPUQuota=80%
TasksMax=4

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
