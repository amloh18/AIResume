# Temporary files
tmp/
temp/

# Python / host tooling — build and host artefacts, never image content. The web image ships no
# `scripts/`: the JobSpy and LinkedIn workers run behind the VPS worker gateway, so nothing in `src/`
# imports them and `tsconfig.json` excludes the directory. Keeping them out of the build context also
# keeps a stale virtualenv or browser profile from being uploaded to the daemon on every deploy.
**/__pycache__/
**/*.pyc
**/.venv/
scripts/

# Agent / project memory — not application content
.workbuddy-ai/

# Local browser caches — the app attaches to the VPS-hosted Chrome over CDP and ships no browser.
.playwright/
# TypeScript incremental build state from a local `tsc` run
*.tsbuildinfo

# Sensitive files
firebase-key.json
*.pem
*.key
*.csv
cookies.txt

# Vercel
.vercel

