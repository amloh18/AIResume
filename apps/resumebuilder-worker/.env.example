# ── resumebuilder-worker — environment template ────────────────────────
# Copy to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# Only this template is committed. Every value here is a placeholder, and the service validates
# them at boot — a malformed value fails loudly at startup rather than at the first request that
# needs it. See the Configuration table in README.md.

# Environment & Service
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
# Reported in logs and in the /health payload. Changing it breaks monitoring — leave it alone.
SERVICE_NAME=buildairesume-job-ingestion

# MongoDB Connection
# A local instance works out of the box. For Atlas the shape is
# mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/buildairesume
MONGODB_DATABASE=buildairesume
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Ingestion Worker Settings
JOB_WORKER_ENABLED=true
DEFAULT_CONCURRENCY=5
DEFAULT_TIMEOUT_MS=30000
DEFAULT_RETRY_COUNT=3
BATCH_SIZE=500
# How long one instance may hold a source. A crashed run releases the lock after this many seconds.
DISTRIBUTED_LOCK_TTL_SECONDS=900

# ATS & API Sources
# Adzuna is the only source that needs credentials. Leave these empty to disable it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTIVE_ENABLED=true
REMOTEOK_ENABLED=true
# JobSpy runs out of process; point this at that worker's host.
JOBSPY_ENABLED=false
JOBSPY_WORKER_URL=http://localhost:8000

# Maintenance & Stale Job Thresholds
STALE_THRESHOLD_DAYS=7
EXPIRATION_THRESHOLD_DAYS=14
