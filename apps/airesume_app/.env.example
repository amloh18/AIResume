# Database Configuration
MONGODB_URI=your-mongodb-connection-string-here
# Override database name (optional, default: extracted from URI)
# MONGODB_DB=airesume

# AI API Keys
GEMINI_API_KEY=your-gemini-api-key-here


# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this-in-production

# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# Token Encryption (32-byte hex key for AES-256-GCM)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Email Service (for email verification, password reset, etc.)
# Hostinger SMTP Configuration
EMAIL_SERVER_HOST=smtp.hostinger.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@yourdomain.com
EMAIL_SERVER_PASSWORD=your-hostinger-email-password

# Alternative: Gmail SMTP (for development)
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@gmail.com
# EMAIL_SERVER_PASSWORD=your-app-password

# ── Application email (queue worker → Stalwart) ───────────────────────
# REQUIRED for the application-email pipeline (POST /api/applications/[id]/email →
# ApplicationEmailQueue → worker). Configuration fails closed: with no sender set, queued
# application emails transition to `failed` (non-retryable) naming the missing variable —
# there is NO hard-coded fallback sender or SMTP host anymore.
APPLICATION_SENDER_EMAIL=applications@yourdomain.com
# Preferred: Stalwart on the private Docker network (never the public hostname — the container
# cannot hairpin to mail.yourdomain.com).
STALWART_SMTP_HOST=
STALWART_SMTP_PORT=587
STALWART_SMTP_USER=
STALWART_SMTP_PASSWORD=
# Inbound mail polling (JMAP) for the communications tab.
STALWART_JMAP_URL=
# Optional local model endpoint; /api/health?deep=1 reports it as unknown when unset.
OLLAMA_BASE_URL=

# Cron job authentication — both header forms are accepted by every /api/cron/* route:
#   Authorization: Bearer <CRON_SECRET>     (preferred)
#   X-Api-Key: <CRON_API_KEY>               (legacy scheduler compatibility)
# Fail CLOSED with 503 when neither is set. Query-string keys (?key=) are rejected.
CRON_SECRET=your-cron-secret-key-change-this-in-production
CRON_API_KEY=

# File Upload (for CV attachments, avatars, etc.)
# For local development
UPLOAD_DIR=./public/uploads

# For production, use cloud storage like AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Optional: S3 URLs for landing assets (set after uploading assets to S3)
# NEXT_PUBLIC_HERO_BANNER_S3_URL=https://your-bucket.s3.your-region.amazonaws.com/landing-assets/herobanner.png
# NEXT_PUBLIC_S3_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com/landing-assets/templates

# Payment Processing (for subscription plans)
# Payment Provider Configuration
# ── Razorpay (default) ────────────────────────────────────────────────
# Real key ids are prefixed `rzp_test_` / `rzp_live_`. These placeholders deliberately are
# NOT, so `.verify/scan-secrets.mjs` stays at zero hits on this file. A scanner that always
# reports a known false positive is a scanner people learn to skim past.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# ── Stripe ────────────────────────────────────────────────────────────
# Same reasoning: real values carry an `sk_test_` / `sk_live_` / `pk_test_` prefix.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# ── Polar (legacy, deprecated) ────────────────────────────────────────
# POLAR_ACCESS_TOKEN=polar_your_polar_access_token_here
# POLAR_WEBHOOK_SECRET=polar_whs_your_polar_webhook_secret_here

# Firebase Configuration (Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Recommended: Use individual environment variables)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternative: Firebase Admin SDK (Service Account Key as JSON string)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Monitoring and Error Tracking
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_WEBHOOK_URL=your-webhook-url-for-backup-notifications
BACKUP_NOTIFY_SUCCESS=true
BACKUP_NOTIFY_FAILURE=true

# Site Verification
# ⚠️ These are OWNERSHIP PROOFS, not analytics ids. A published verification token lets
# someone else claim the domain in the provider's console — which is why they are read from
# the environment here rather than hardcoded in src/app/layout.tsx, as they once were.
GOOGLE_SITE_VERIFICATION=your-google-site-verification-code
BING_SITE_VERIFICATION=your-bing-site-verification-code
# Impact's snippet uses `value=` rather than `content=` — see src/app/layout.tsx.
IMPACT_SITE_VERIFICATION=your-impact-site-verification-code

# ── Admin operations scripts (NOT read at runtime) ────────────────────
# scripts/setup-production-admin.ts, scripts/delete-admins.ts and scripts/list-admins.ts
# run by hand against the production database. They used to carry a real admin address and
# password as constants; they are now env-driven and refuse to run without them.
#
# ⚠️ delete-admins.ts deletes every admin whose email is NOT PROD_ADMIN_EMAIL. An empty
# value matches everything and would wipe every administrator — the script now exits
# non-zero rather than proceeding. Do not "fix" that guard.
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=
# Comma-separated. Admins in this list are demoted by delete-admins.ts, never deleted.
DEV_ADMIN_EMAILS=

# ── Dev-only auth bypass (NEVER set in production) ────────────────────
# src/app/api/auth/dev-bypass/route.ts mints a session without credentials. It is gated on
# NODE_ENV !== 'production' and returns 500 if the admin address is unset — it previously
# defaulted to a real administrator's address, so a single request in a dev deployment
# granted superadmin.
DEV_BYPASS_ADMIN_EMAIL=
DEV_BYPASS_USER_EMAIL=

# ── One-off data-recovery script (NOT read at runtime) ────────────────
# scripts/recover-split-db-documents.mjs — dry-run by default; every identifier is supplied
# here so no real ObjectId, email or database name lives in the source.
# (Its runbook is an internal operations document and is deliberately not linked from this
# public template — see CONTRIBUTING.md.)
RECOVERY_SOURCE_DB=
RECOVERY_SOURCE_OWNER_ID=
RECOVERY_GUEST_OWNER_ID=
RECOVERY_TARGET_OWNER_ID=
RECOVERY_OWNER_EMAIL=
RECOVERY_MASTER_CV_ID=
# JSON array, e.g. [{"collection":"cvs","id":"..."}]
RECOVERY_HISTORY_ITEMS=

# Sponsorship Registry Configuration
# UK Sponsor Registry CSV URL (from https://www.gov.uk/government/publications/register-of-licensed-sponsors-workers)
UK_SPONSOR_REGISTRY_URL=
# US H-1B Employer Data URL (from https://www.dol.gov/agencies/eta/foreign-labor/performance)
US_H1B_DATA_URL=
US_H1B_DATA_FORMAT=csv
# Cron authentication for scheduled registry updates: see CRON_SECRET / CRON_API_KEY below.

# ── LinkedIn Worker Configuration ──────────────────────────────────────
# Set to 'true' to enable the LinkedIn browser worker (VPS only)
LINKEDIN_ENABLED=false
# Persistent browser profile directory (must exist on VPS)
LINKEDIN_BROWSER_PROFILE_DIR=/var/lib/buildairesume/browser-profiles/linkedin
# Search limits per run
LINKEDIN_MAX_SEARCHES_PER_RUN=5
LINKEDIN_MAX_PAGES_PER_SEARCH=2
LINKEDIN_MAX_JOBS_PER_SEARCH=100
# Runtime limits
LINKEDIN_MAX_RUNTIME_SECONDS=600
LINKEDIN_COOLDOWN_SECONDS=60
# Concurrency (max simultaneous browser instances)
LINKEDIN_WORKER_CONCURRENCY=1
# Default search parameters (used when no task specified)
LINKEDIN_DEFAULT_KEYWORD=software engineer
# Debug mode (screenshots, verbose logs)
LINKEDIN_DRY_RUN=false
LINKEDIN_DEBUG=false
LINKEDIN_DEBUG_DIR=/var/lib/buildairesume/debug/linkedin
# Ingestion API URL (for worker -> API communication)
# ⚠️ This endpoint is no longer served by this app — the admin API routes moved to the
# operations app during the split. Leave it unset here; the worker's own .env owns the value
# in production, and the worker can only use it once the route has a token-based guard
# (it currently requires an admin browser session).
LINKEDIN_INGEST_API_URL=
# ── Region Rotation (Global Ingestion) ───────────────────────────────
# Strategy: "demand" (scheduler picks regions from user demand) | "round-robin" | "fixed"
LINKEDIN_REGION_STRATEGY=demand
# Comma-separated country codes to rotate through
LINKEDIN_REGIONS=US,CA,GB,IN,AU,DE,FR,NL,SG,AE
# How many regions to search per run
LINKEDIN_MAX_REGIONS_PER_RUN=3

# ── Whisper Transcription Worker ──────────────────────────────────────
# Set to 'true' on VPS to enable local Whisper fallback
WHISPER_ENABLED=true
# Worker URL (internal, not public)
WHISPER_WORKER_URL=http://127.0.0.1:8787
# Model: tiny.en, base.en, small.en, medium.en
WHISPER_MODEL=small.en
# Language
WHISPER_LANGUAGE=en
# Device: auto, cpu, cuda
WHISPER_DEVICE=auto
# Compute type: auto, int8, float16, float32
WHISPER_COMPUTE_TYPE=auto
# Limits
WHISPER_MAX_AUDIO_SECONDS=900
WHISPER_MAX_CONCURRENT_JOBS=1
WHISPER_TIMEOUT_MS=120000
# Debug
WHISPER_DEBUG=false

# ── VPS-hosted services (web tier decoupling) ─────────────────────────
# The production image ships no Python, no Chromium and no scripts/. These point it at the services that
# run on the VPS host instead. Empty values mean the corresponding capability is unavailable in
# production: ingestion skips the source, auto-apply routes to manual review, and PDF export falls back
# to jsPDF. See docs/self-hosting.md.
#
# Job discovery gateway (JobSpy + LinkedIn workers) — scripts/vps-install-worker-gateway.sh
INGESTION_WORKER_URL=
INGESTION_WORKER_TOKEN=
# Ingestion microservice (buildairesume-job-ingestion, port 4001) — owns the SmartRecruiters,
# Workable, Recruitee and Personio ATS sources and their 30-minute scheduler. When set, runs for
# those sources are delegated over HTTP; its /health feeds the admin job-intelligence page.
INGESTION_SERVICE_URL=
# Headless Chrome over CDP — scripts/vps-install-browser-service.sh
# Both accept an http:// CDP base URL (http://172.17.0.1:9222) or a browser-level ws:// URL.
PLAYWRIGHT_REMOTE_URL=
PUPPETEER_BROWSER_WS_ENDPOINT=
# Escape hatches for a host that runs the app directly beside Python/Chromium. Leave false in production.
BROWSER_ALLOW_LOCAL_LAUNCH=false
ALLOW_LOCAL_INGESTION_WORKERS=false
# Items drained per /api/cron/auto-apply run (default 5, max 20). Browser work is heavy — keep it low.
AUTO_APPLY_CRON_BATCH=5

# ── Demo / seeding endpoints ──────────────────────────────────────────
# A few routes write SYNTHETIC data — fabricated ATS scores, demo users with known passwords, a pro
# subscription that was never paid for. In production they are refused with 404 unless the matching
# `_ENABLED` variable below is exactly 'true', and when enabled they additionally require an
# `x-seed-secret` header matching the `_SECRET` variable.
#
# Leave ALL of these unset in production. The gate fails closed: unset means disabled. Setting only
# `_ENABLED` without `_SECRET` still refuses every request (401), so enabling an endpoint is
# deliberately two steps. See `src/lib/api/seed-guard.ts`.
#
# SEED_DASHBOARD_ENABLED=true          # POST /api/seed-dashboard       — 50 jobs + fabricated scores
# SEED_DASHBOARD_SECRET=
# ADD_MOCKUP_JOBS_ENABLED=true         # POST /api/add-mockup-jobs      — demo user + mockup jobs
# ADD_MOCKUP_JOBS_SECRET=

# ── Background workers (web / worker split) ───────────────────────────
# Email delivery, inbound mail ingestion, the application queue and the reconciliation watchdog run in
# the dedicated worker service (`docker build --target worker`), not in the web container: a redeploy of
# the site used to kill them mid-flight. See docs/self-hosting.md.
#
# WEB SERVICE: set this, otherwise the web container starts the loops itself and redeploys interrupt them.
WORKER_ROLE=web
# WORKER SERVICE: leave unset (defaults to all) or set explicitly.
# WORKER_ROLE=worker
# Health/status port of the worker service. Internal to the Docker network — do not publish it.
WORKER_HEALTH_PORT=8791
# WEB SERVICE: where the worker answers health checks, used by /api/communications/sync for ops.
# Leave empty and the endpoint reports the loop as not running here instead of guessing.
WORKER_HEALTH_URL=
# Worker service tuning. GRACE is how long an in-flight application may finish before exit; Docker's
# stop grace period (Dokploy: stop timeout) must be larger or the container is SIGKILLed first.
WORKER_SHUTDOWN_GRACE_MS=5000
WORKER_HEARTBEAT_MS=300000
WORKER_HEALTH_HOST=0.0.0.0