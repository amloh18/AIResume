# Build context is the repository root — now the app itself, since this file lives in the app's own
# repository. Patterns are still written to match at ANY depth: a bare `node_modules` matches only
# the top level, and the depth-insensitive form stays correct if the tree is ever nested again.
# Getting this wrong ships ~1.4 GB of local modules as build context.

# Dependencies
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
**/.next/
**/out/

# Build artifacts
**/build/
**/dist/
**/*.tsbuildinfo
**/next-env.d.ts

# Environment variables — never in the image. Only the `.example` templates are allowed through.
**/.env
**/.env.*
!**/.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Documentation
**/*.md

# Test files
**/test-*.tsx
**/test-*.ts
**/debug-*.tsx
**/debug-*.ts

# Backup files
*.backup
backups/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Python / host tooling — host artefacts, never image content. The web image ships no `scripts/` as
# files (the runner copies only `public/`, `.next/`, `node_modules/` and `package.json`): the JobSpy and
# LinkedIn workers run behind the VPS worker gateway.
#
# `scripts/` itself stays in the build context: `scripts/` holds `build-worker.mjs` and the
# shims beside it, which the worker stage (`--target worker`) needs for `npm run build:worker`. That
# directory is a few hundred KB of sources — the bulk to keep out is the virtualenv and browser state
# that the host tooling creates in place, not the scripts themselves.
**/__pycache__/
**/*.pyc
**/.venv/
**/.playwright/
**/browser-profile/
**/chrome-profile/

# The job-ingestion microservice is a separate image with its own Dockerfile and its own build
# context. Nothing in this image reads it, so keep it out of the app's context entirely.
apps/resumebuilder-worker/

# Agent / project memory — not application content
.workbuddy-ai/
.claude/

# Local development state that is never image content
.tmp-mongo/
brag-output/
.verify/build/

# Local browser caches — the app attaches to the VPS-hosted Chrome over CDP and ships no browser.
.playwright/

# Sensitive files
firebase-key.json
*.pem
*.key
*.csv
cookies.txt

# Vercel
.vercel

# Coverage
**/coverage/
