# Database Configuration
MONGODB_URI=your-mongodb-connection-string-here
# Override database name (optional, default: extracted from URI)
# MONGODB_DB=airesume

# AI API Keys
GEMINI_API_KEY=your-gemini-api-key-here


# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this-in-production

# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# Token Encryption (32-byte hex key for AES-256-GCM)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Email Service (for email verification, password reset, etc.)
# Hostinger SMTP Configuration
EMAIL_SERVER_HOST=smtp.hostinger.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@yourdomain.com
EMAIL_SERVER_PASSWORD=your-hostinger-email-password

# Alternative: Gmail SMTP (for development)
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@gmail.com
# EMAIL_SERVER_PASSWORD=your-app-password

# File Upload (for CV attachments, avatars, etc.)
# For local development
UPLOAD_DIR=./public/uploads

# For production, use cloud storage like AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Optional: S3 URLs for landing assets (set after uploading assets to S3)
# NEXT_PUBLIC_HERO_BANNER_S3_URL=https://your-bucket.s3.your-region.amazonaws.com/landing-assets/herobanner.png
# NEXT_PUBLIC_S3_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com/landing-assets/templates

# Payment Processing (for subscription plans)
# Payment Provider Configuration
# ── Razorpay (default) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# ── Polar (legacy, deprecated) ────────────────────────────────────────
# POLAR_ACCESS_TOKEN=polar_your_polar_access_token_here
# POLAR_WEBHOOK_SECRET=polar_whs_your_polar_webhook_secret_here

