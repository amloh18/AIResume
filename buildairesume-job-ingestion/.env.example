# Environment & Service
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
SERVICE_NAME=buildairesume-job-ingestion

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/buildairesume
MONGODB_DATABASE=buildairesume
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Ingestion Worker Settings
JOB_WORKER_ENABLED=true
DEFAULT_CONCURRENCY=5
DEFAULT_TIMEOUT_MS=30000
DEFAULT_RETRY_COUNT=3
BATCH_SIZE=500
DISTRIBUTED_LOCK_TTL_SECONDS=900

# ATS & API Sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTIVE_ENABLED=true
REMOTEOK_ENABLED=true
JOBSPY_ENABLED=false
JOBSPY_WORKER_URL=http://localhost:8000

# Maintenance & Stale Job Thresholds
STALE_THRESHOLD_DAYS=7
EXPIRATION_THRESHOLD_DAYS=14
